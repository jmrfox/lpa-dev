#!/usr/bin/env bash
# Print git status for Lightning Pose and Lightning Pose App.
# Usage: ./bin/gitstatus

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LPA_DEV_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

print_status() {
  local label=$1
  local dir=$2

  printf '\n======== %s ========\n' "$label"
  if [[ ! -d "$dir/.git" ]]; then
    printf 'Not a git repo: %s\n' "$dir" >&2
    return 1
  fi
  git -C "$dir" status
}

print_status "LP  lightning-pose" "${LPA_DEV_ROOT}/lightning-pose"
print_status "LPA lightning-pose-app" "${LPA_DEV_ROOT}/lightning-pose-app"
printf '\n'
